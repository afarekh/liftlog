rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in user may read and write only their own document.
    // Anonymous accounts are rejected outright: they cannot be recovered
    // if the device's storage is cleared, so we never let them own data.
    match /users/{uid} {
      allow read, write: if request.auth != null
                         && request.auth.uid == uid
                         && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
